  m_InsertStartCode: '// Create a new Node

    string data = "Sample Data";

    Node*
    node = new Node(data);


    m_Head = node;'
  m_CurrentPointerCode: Node* currentPointer = null;
  m_InsertAtTheEndCode: "Node* currentPtr = headPtr;\n\n// traverse the list until
    at the end\nwhile(*currentPtr.nextPtr != null)\n\tcurrentPtr = *currentPtr.nextPtr\n\n//
    Create newNode\nNode* newNode = new Node(newData)\n\n// Add the node to the list\n*currentPtr.nextPtr
    = newNode;"
  m_InsertAtTheMiddleCode: "Node* currentPtr = headPtr;\n\n// Traverse the list until
    just before the desired pos\nint currPos = 0;\nwhile(currPos + 1 < insertionPos)\n\tcurrentPtr
    = *currentPtr.nextPtr\n\n// Create newNode\nNode* newNode = new Node(newData)\n\n//
    Set the newNode's next ptr to the current's next ptr\n*newNode.nextPtr = *currentPtr.nextPtr\n\n//
    Add the node to the list\n*currentPtr.nextPtr = newNode;"
  m_ToInsert: {fileID: 8300000, guid: b5a99a7ae9d0e7e408749d7be316537f, type: 3}
