  m_ToInsertANodeBet: {fileID: 8300000, guid: 595de0eff2a75eb4294a1d073cb2d3fb, type: 3}
  m_ThenWeCreateANewNode: {fileID: 8300000, guid: 42886a245b201a54a9231f7546791758, type: 3}
  m_FinallyWeCanSet: {fileID: 8300000, guid: 33573b78407ac1c46baab5a52cd1dd0b, type: 3}
