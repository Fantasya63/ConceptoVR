  m_ScriptVisualizer: {fileID: 622279553}
  m_DeleteTraverseCode: "public void Delete(int pos)\r\n{\r\n    int currentPos =
    0;\r\n    Node* currentPtr = m_HeadPtr;\r\n\r\n    // Traverse until we are next
    to the position to delete\r\n    while(currentPos + 1 < pos)\r\n    {\r\n       
    currentPtr = *currentPtr.nextPtr;\r\n\tcurrentPos++;\r\n    }\n\n    ...\n}\r\n"
  m_TempToNodeToDeleteCode: "public void Delete(int pos)\n{\n    ...\n\n    // Traverse
    until we are next to the position to delete\n    while(currentPos + 1 < pos)\n   
    {\n        currentPtr = *currentPtr.nextPtr;\n\tcurrentPos++;\n    }\n\n    //
    Create a temp ptr to point to the node to delete to avoid leaking the node after
    the chain is broken.\n    Node* temp = *currentPtr.nextPtr;\n\n    ...\n}\n"
  m_CurrNodeNextToNodetoRepCode: "public void Delete(int pos)\n{\n    ...\n    //
    Create a temp ptr to point to the node to delete to avoid leaking the node after
    the chain is broken.\n    Node* temp = *currentPtr.nextPtr;\n\n    // Unlink
    the node to be deleted from the lists\n    *currentPtr.next = *temp.nextPtr;\n\n   
    ...\n}"
  m_DeleteNodeStep: "public void Delete(int pos)\n{\n    ...\n\n    Node* temp =
    *currentPtr.nextPtr;\n    *currentPtr.next = *temp.nextPtr;\n\n    \n    delete(temp);\n\n   
    ...\n}"
  m_StartingValues: 17000000360000005901000024000000
