    - target: {fileID: 2423970045907289593, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: code
      value: "void Traverse()\n{\n    Node* current = m_HeadPtr;\n    string output
        = \"Lists: \";\n    \n    // Move through the lists until we reach the end\n   
        while (m_Current.GetData() != null)\n    {\n        output += *current.Data
        + \" -> \";\n\tcurrent = *current.nextPtr;\n    }\n\n    output += \"NULL\";\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 4106129285770532639, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_Name
      value: TemplateScriptDisplay
      objectReference: {fileID: 0}
    - target: {fileID: 4106129285770532639, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5713243162175387829, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_text
      value: "<color=#569CD6>Node</color>* currentPtr = headPtr;\n\n<color=#6A9955>//
        Traverse the list until just before the desired pos</color>\n<color=#569CD6>int</color>
        currPos = <color=#B5CEA8>0</color>;\n<color=#569CD6>while</color>(currPos
        + <color=#B5CEA8>1</color> < insertionPos)\n\tcurrentPtr = *currentPtr.nextPtr\n\n<color=#6A9955>//
        Create newNode</color>\n<color=#569CD6>Node</color>* newNode = <color=#569CD6>new</color>
        <color=#569CD6>Node</color>(newData)\n\n<color=#6A9955>// Set the newNode's
        next ptr to the current's next ptr</color>\n*newNode.nextPtr = *currentPtr.nextPtr\n\n<color=#6A9955>//
        Add the node to the list</color>\n*currentPtr.nextPtr = newNode;\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8373872859730456590, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_IgnoreReversedGraphics
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
