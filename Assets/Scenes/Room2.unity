      propertyPath: code
      value: "Node* currentPtr = headPtr;\n\n// Traverse the list until just before
        the desired pos\nint currPos = 0;\nwhile(currPos + 1 < insertionPos)\n\tcurrentPtr
        = *currentPtr.nextPtr\n\n// Create newNode\nNode* newNode = new Node(newData)\n\n//
        Set the newNode's next ptr to the current's next ptr\n*newNode.nextPtr =
        *currentPtr.nextPtr\n\n// Add the node to the list\n*currentPtr.nextPtr =
        newNode;\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4106129285770532639, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_Name
      value: TemplateScriptDisplay
      objectReference: {fileID: 0}
