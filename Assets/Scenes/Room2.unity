    - target: {fileID: 2423970045907289593, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: code
      value: "// Takes in a string key and returns an index in the range 0 to boxesCount
        - 1\n// to be used to lookup on the hashtable\npublic static int Hash(string
        key, int boxesCount)\n{\n    int hash = 0;\n\n    // Add all the character's
        ascii values \n    foreach (char c in key)\n    {\n        hash += c; //
        add ASCII value\n    }\n\n    // Divide the resulting sum by the amount of
        boxes and get the remainder\n    // The remainder will serve as the index
        for our boxes\n    return Mathf.Abs(hash) % boxesCount;\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 2423970045907289593, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_NotifClip
      value: 
      objectReference: {fileID: 8300000, guid: 4d2ebc1c6fadb934abf4ae0e259072d5, type: 3}
    - target: {fileID: 4106129285770532639, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_Name
      value: ScriptDisplayScreen
      objectReference: {fileID: 0}
    - target: {fileID: 4106129285770532639, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5713243162175387829, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
      propertyPath: m_text
      value: "<color=#6A9955>// Takes in a <color=#569CD6>string</color> key and
        returns an index in the range <color=#B5CEA8>0</color> to boxesCount - <color=#B5CEA8>1</color></color>\n<color=#6A9955>//
        to be used to lookup on the hashtable</color>\n<color=#569CD6>public</color>
        <color=#569CD6>static</color> <color=#569CD6>int</color> <color=#DCDCAA>Hash</color>(<color=#569CD6>string</color>
        key, <color=#569CD6>int</color> boxesCount)\n{\n    <color=#569CD6>int</color>
        hash = <color=#B5CEA8>0</color>;\n\n    <color=#6A9955>// Add all the character's
        ascii values </color>\n    <color=#DCDCAA>foreach </color>(char c in key)\n   
        {\n        hash += c; <color=#6A9955>// add ASCII value</color>\n    }\n\n   
        <color=#6A9955>// Divide the resulting sum by the amount of boxes and get
        the remainder</color>\n    <color=#6A9955>// The remainder will serve as
        the index <color=#569CD6>for</color> our boxes</color>\n    <color=#569CD6>return</color>
        Mathf.<color=#DCDCAA>Abs</color>(hash) % boxesCount;\n}"
      objectReference: {fileID: 0}
    - target: {fileID: 8569507196818311801, guid: a6e720393d4c116469011282c09fe3a4, type: 3}
