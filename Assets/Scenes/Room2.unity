  m_ScriptVisualizer: {fileID: 1828041995}
  m_ScriptGrowSpeed: 1
  m_TraverseCode: "void Traverse()\r\n{\r\n    Node* current = m_HeadPtr;\r\n   
    string output = \"Lists: \";\r\n    \r\n    // Move through the lists until we
    reach the end\r\n    while (m_Current.GetData() != null)\r\n    {\r\n       
    output += *current.Data + \" -> \";\r\n\tcurrent = *current.nextPtr;\r\n    }\r\n\r\n   
    output += \"NULL\";\r\n}"
  m_StartingValues: 0100000002000000030000000400000005000000060000000700000008000000090000000a000000
  m_DelayDurTraverse: 1
